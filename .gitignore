# ==============================================================================
# VELORA FUTURE LAB - ROOT .GITIGNORE
# Comprehensive Git ignore rules for Next.js frontend, Node.js backend, and PostgreSQL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment variables and secrets
# ------------------------------------------------------------------------------
.env
.env.*
.env*.local
*.env
*.env.*

# Explicitly ensure example environment template files are NEVER ignored
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Secret keys, certificates, and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
credentials/
id_rsa
id_ecdsa
id_ed25519

# ------------------------------------------------------------------------------
# 2. Dependencies
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
jspm_packages/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ------------------------------------------------------------------------------
# 3. Build and cache outputs
# ------------------------------------------------------------------------------
# Next.js build output
.next/
**/.next/
out/
**/out/

# General build artifacts
dist/
**/dist/
build/
**/build/

# Caching systems and compiler outputs
.turbo/
**/.turbo/
.cache/
**/.cache/
.parcel-cache/
.vercel
**/.vercel
*.tsbuildinfo
**/*.tsbuildinfo
next-env.d.ts

# ------------------------------------------------------------------------------
# 4. Logs and diagnostics
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 5. Database backups and local dump files
# ------------------------------------------------------------------------------
# Local PostgreSQL database backups and dumps (DO NOT upload to GitHub)
velora_futurelab_backup.dump
*.dump
*.dump.*
*.backup
*.bak
*.sql.gz
*.tar.gz
*.psql.bin

# ------------------------------------------------------------------------------
# 6. Operating system files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# 7. IDE, editor, and workspace configurations
# ------------------------------------------------------------------------------
# Ignore local VS Code workspace user state, while preserving shared configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains / IntelliJ / WebStorm
.idea/

# Vim / Emacs temporary files
*~
*.swp
*.swo

# ------------------------------------------------------------------------------
# 8. Testing and coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
